# Copy this file to .env and fill in real values for your environment.
# .env is already gitignored and should never be committed.

# Generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key

# Set to False in any real deployment
DJANGO_DEBUG=True

# Comma-separated list, e.g. "example.com,www.example.com"
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0